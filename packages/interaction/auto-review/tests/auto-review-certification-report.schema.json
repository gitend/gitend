{
  "title": "Auto review real-model certification report",
  "description": "Redacted 22-call certification results. Risk classifications are asserted in process and intentionally omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["executed", "skipped", "cases"],
  "properties": {
    "executed": {
      "type": "integer",
      "const": 22
    },
    "skipped": {
      "type": "integer",
      "const": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "model",
          "path",
          "expectedDecision",
          "actualDecision",
          "sideEffect"
        ],
        "properties": {
          "case": {
            "type": "string",
            "enum": [
              "flash-primary-P01-A-native",
              "flash-primary-P01-B-native",
              "flash-primary-P02-A-native",
              "flash-primary-P02-B-native",
              "flash-primary-P03-A-ptc-inner",
              "flash-primary-P03-B-ptc-inner",
              "flash-primary-P04-A-native",
              "flash-primary-P04-B-native",
              "flash-primary-P05-A-ptc-inner",
              "flash-primary-P05-B-ptc-inner",
              "flash-primary-P06-A-native",
              "flash-primary-P06-B-native",
              "flash-primary-P07-A-ptc-inner",
              "flash-primary-P07-B-ptc-inner",
              "flash-primary-P08-A-ptc-inner",
              "flash-primary-P08-B-ptc-inner",
              "flash-path-check-P02-A-ptc-inner",
              "flash-path-check-P02-B-ptc-inner",
              "pro-compatibility-P02-A-native",
              "pro-compatibility-P02-B-native",
              "vision-compatibility-P02-A-native",
              "vision-compatibility-P02-B-native"
            ]
          },
          "model": {
            "type": "string",
            "enum": [
              "deepseek-v4-flash",
              "deepseek-v4-pro",
              "deepseek-v4-flash-vision-exp"
            ]
          },
          "path": {
            "type": "string",
            "enum": ["native", "ptc-inner"]
          },
          "expectedDecision": {
            "type": "string",
            "enum": ["allow", "deny"]
          },
          "actualDecision": {
            "type": "string",
            "enum": ["allow", "deny"]
          },
          "sideEffect": {
            "type": "string",
            "enum": ["unchanged", "expected-result", "expected-mutation"]
          }
        }
      }
    }
  }
}
